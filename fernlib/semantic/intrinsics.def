// X-macro list of every intrinsic tag. Included with INTRINSIC defined to build
// the IntrinsicKind enum, the tag table, and the operator symbol table.
//
// INTRINSIC(name, tag, symbol)
// tag: the string written in @Intrinsic("..."), the contract between core.fn and every backend.
// symbol: how the operation prints in FHIR and FLIR dumps, empty when it is not an operator.

// i32
INTRINSIC(I32LiteralI32,  "i32.literal_i32", "")
INTRINSIC(I32FromU8,      "i32.from_u8",     "")
INTRINSIC(I32FromF32,     "i32.from_f32",    "")
INTRINSIC(I32FromBool,    "i32.from_bool",   "")
INTRINSIC(I32Neg,         "i32.neg",         "-")
INTRINSIC(I32Pos,         "i32.pos",         "+")
INTRINSIC(I32Add,         "i32.add",         "+")
INTRINSIC(I32Sub,         "i32.sub",         "-")
INTRINSIC(I32Mul,         "i32.mul",         "*")
INTRINSIC(I32Div,         "i32.div",         "/")
INTRINSIC(I32Eq,          "i32.eq",          "==")
INTRINSIC(I32Ne,          "i32.ne",          "!=")
INTRINSIC(I32Gt,          "i32.gt",          ">")
INTRINSIC(I32Lt,          "i32.lt",          "<")
INTRINSIC(I32Ge,          "i32.ge",          ">=")
INTRINSIC(I32Le,          "i32.le",          "<=")

// f32
INTRINSIC(F32LiteralI32,  "f32.literal_i32", "")
INTRINSIC(F32LiteralF32,  "f32.literal_f32", "")
INTRINSIC(F32FromI32,     "f32.from_i32",    "")
INTRINSIC(F32FromU8,      "f32.from_u8",     "")
INTRINSIC(F32Neg,         "f32.neg",         "-")
INTRINSIC(F32Pos,         "f32.pos",         "+")
INTRINSIC(F32Add,         "f32.add",         "+")
INTRINSIC(F32Sub,         "f32.sub",         "-")
INTRINSIC(F32Mul,         "f32.mul",         "*")
INTRINSIC(F32Div,         "f32.div",         "/")
INTRINSIC(F32Eq,          "f32.eq",          "==")
INTRINSIC(F32Ne,          "f32.ne",          "!=")
INTRINSIC(F32Gt,          "f32.gt",          ">")
INTRINSIC(F32Lt,          "f32.lt",          "<")
INTRINSIC(F32Ge,          "f32.ge",          ">=")
INTRINSIC(F32Le,          "f32.le",          "<=")

// u8
INTRINSIC(U8LiteralI32,   "u8.literal_i32",  "")
INTRINSIC(U8FromI32,      "u8.from_i32",     "")
INTRINSIC(U8FromF32,      "u8.from_f32",     "")
INTRINSIC(U8Add,          "u8.add",          "+")
INTRINSIC(U8Sub,          "u8.sub",          "-")
INTRINSIC(U8Mul,          "u8.mul",          "*")
INTRINSIC(U8Div,          "u8.div",          "/")
INTRINSIC(U8Eq,           "u8.eq",           "==")
INTRINSIC(U8Ne,           "u8.ne",           "!=")
INTRINSIC(U8Gt,           "u8.gt",           ">")
INTRINSIC(U8Lt,           "u8.lt",           "<")
INTRINSIC(U8Ge,           "u8.ge",           ">=")
INTRINSIC(U8Le,           "u8.le",           "<=")

// bool
INTRINSIC(BoolFromI32,    "bool.from_i32",   "")
INTRINSIC(BoolNot,        "bool.not",        "!")
INTRINSIC(BoolEq,         "bool.eq",         "==")
INTRINSIC(BoolNe,         "bool.ne",         "!=")
INTRINSIC(BoolAnd,        "bool.and",        "&&")
INTRINSIC(BoolOr,         "bool.or",         "||")

// c8
INTRINSIC(C8Eq,           "c8.eq",           "==")
INTRINSIC(C8Ne,           "c8.ne",           "!=")
INTRINSIC(C8Gt,           "c8.gt",           ">")
INTRINSIC(C8Lt,           "c8.lt",           "<")
INTRINSIC(C8Ge,           "c8.ge",           ">=")
INTRINSIC(C8Le,           "c8.le",           "<=")

// string
INTRINSIC(StringInit,     "string.init",     "")
INTRINSIC(StringEq,       "string.eq",       "==")
INTRINSIC(StringNe,       "string.ne",       "!=")
INTRINSIC(StringConcat,   "string.concat",   "+")
INTRINSIC(StringGet,      "string.get",      "")

// array
INTRINSIC(ArrayInit,      "array.init",      "")
INTRINSIC(ArrayGet,       "array.get",       "")
INTRINSIC(ArraySet,       "array.set",       "")
INTRINSIC(ArrayCopyTo,    "array.copy_to",   "")
