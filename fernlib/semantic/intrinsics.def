// X-macro list of every intrinsic tag. Included with INTRINSIC defined to build
// the IntrinsicKind enum, the tag table, and the operator symbol table.
//
// INTRINSIC(name, tag, symbol)
// tag: the string written in @Intrinsic("..."), the contract between core.fn and every backend.
// symbol: how the operation prints in FHIR and FLIR dumps, empty when it is not an operator.

// i8
INTRINSIC(I8LiteralI32,   "i8.literal_i32",  "")
INTRINSIC(I8FromI16,      "i8.from_i16",     "")
INTRINSIC(I8FromI32,      "i8.from_i32",     "")
INTRINSIC(I8FromI64,      "i8.from_i64",     "")
INTRINSIC(I8FromU8,       "i8.from_u8",      "")
INTRINSIC(I8FromU16,      "i8.from_u16",     "")
INTRINSIC(I8FromU32,      "i8.from_u32",     "")
INTRINSIC(I8FromU64,      "i8.from_u64",     "")
INTRINSIC(I8FromF16,      "i8.from_f16",     "")
INTRINSIC(I8FromF32,      "i8.from_f32",     "")
INTRINSIC(I8FromF64,      "i8.from_f64",     "")
INTRINSIC(I8Neg,          "i8.neg",          "-")
INTRINSIC(I8Pos,          "i8.pos",          "+")
INTRINSIC(I8Add,          "i8.add",          "+")
INTRINSIC(I8Sub,          "i8.sub",          "-")
INTRINSIC(I8Mul,          "i8.mul",          "*")
INTRINSIC(I8Div,          "i8.div",          "/")
INTRINSIC(I8Mod,          "i8.mod",          "%")
INTRINSIC(I8Eq,           "i8.eq",           "==")
INTRINSIC(I8Ne,           "i8.ne",           "!=")
INTRINSIC(I8Gt,           "i8.gt",           ">")
INTRINSIC(I8Lt,           "i8.lt",           "<")
INTRINSIC(I8Ge,           "i8.ge",           ">=")
INTRINSIC(I8Le,           "i8.le",           "<=")

