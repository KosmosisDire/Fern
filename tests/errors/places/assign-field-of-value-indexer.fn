---
Description: A value returning indexer yields a copy, so assigning to a field of the result is an error
Expected: FN3221
---

type Vec2
{
    x: i32

    init(x: i32)
    {
        this.x = x
    }
}

type Box
{
    item: Vec2

    init(item: Vec2)
    {
        this.item = item
    }

    op [](index: i32) -> Vec2
    {
        return item
    }

    op []=(index: i32, value: Vec2)
    {
        item = value
    }
}

type Program
{
    static fn Main -> i32
    {
        var b = Box(Vec2(1))
        b[0].x = 50
        return b[0].x
    }
}
