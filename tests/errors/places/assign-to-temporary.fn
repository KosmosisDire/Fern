---
Description: Assigning to a field of a temporary value is an error
Expected: FN3221
---

type Vec2
{
    x: i32

    init(x: i32)
    {
        this.x = x
    }
}

type Program
{
    static fn Make() -> Vec2
    {
        return Vec2(1)
    }

    static fn Main -> i32
    {
        Make().x = 5
        return 0
    }
}
