---
Description: Instance field referenced by bare name inside a static function
Expected: FN3219
---

type Counter
{
    value: i32

    init(value: i32)
    {
        this.value = value
    }

    static fn Get(bogus: i32) -> i32
    {
        return value
    }
}

type Program
{
    static fn Main -> i32
    {
        return Counter.Get(1234)
    }
}
