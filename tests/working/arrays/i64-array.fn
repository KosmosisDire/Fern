---
Description: i64 array elements read and write at full width
Expected: true
---

type Program
{
    static fn Main -> bool
    {
        var arr: i64[] = [1i64, 2000000000000i64, -3i64]
        arr[0] = arr[1] + 5i64
        var sum = arr[0] + arr[2]

        return arr.Length() == 3
            && arr[0] == 2000000000005i64
            && arr[2] == -3i64
            && sum == 2000000000002i64
    }
}
