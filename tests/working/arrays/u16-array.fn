---
Description: u16 array elements read and write at their two byte stride
Expected: true
---

type Program
{
    static fn Main -> bool
    {
        var arr: u16[] = [1000, 40000, 3]
        arr[0] = arr[1] + 5u16
        var sum = arr[0] + arr[2]

        return arr.Length() == 3
            && arr[0] == 40005u16
            && arr[2] == 3u16
            && sum == 40008u16
    }
}
