---
Description: Bare literals past the i32 range keep their value when the target is i64
Expected: true
---

type Program
{
    static fn Main -> bool
    {
        var positive: i64 = 5000000000
        var negative: i64 = -5000000000
        var folded: i64 = 3000000000 + 1

        return positive == 5000000000i64
            && negative == -5000000000i64
            && folded == 3000000001i64
    }
}
