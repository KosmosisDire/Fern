---
Description: A pointer copy moves a run of elements and handles overlapping runs
Expected: 11234
---

type Program
{
    static fn Main -> i32
    {
        var a: i32[] = [1, 2, 3, 4, 5]
        a.Data().CopyTo(a.Data() + 1, 4)
        return a[0] * 10000 + a[1] * 1000 + a[2] * 100 + a[3] * 10 + a[4]
    }
}
