---
Description: A value type indexer setter writes into the receiver itself, not a copy of it
Expected: 12
---

type Cell
{
    value: i32

    init(value: i32)
    {
        this.value = value
    }

    op [](index: i32) -> i32
    {
        return value
    }

    op []=(index: i32, newValue: i32)
    {
        value = newValue
    }
}

type Program
{
    static fn Main -> i32
    {
        var c = Cell(1)
        c[0] = 5
        c[0] += 7
        return c.value
    }
}
