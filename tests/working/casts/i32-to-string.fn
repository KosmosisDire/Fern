---
Description: Core cast from i32 to string covering positive, zero, negative, and i32 min
Expected: true
---

type Program
{
    static fn Main -> bool
    {
        var a = (string)123 == "123"
        var b = (string)0 == "0"
        var n = -456
        var c = (string)n == "-456"
        var m = -2147483648
        var d = (string)m == "-2147483648"
        return a && b && c && d
    }
}
