---
Description: A static initializer may run code, like constructing a value type
Expected: 30
---

type Vec2
{
    x: i32
    y: i32

    init(x: i32, y: i32)
    {
        this.x = x
        this.y = y
    }
}

type Config
{
    static origin: Vec2 = Vec2(10, 20)
}

type Program
{
    static fn Main -> i32
    {
        return Config.origin.x + Config.origin.y
    }
}
