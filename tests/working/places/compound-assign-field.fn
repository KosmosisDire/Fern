---
Description: Compound assignment on a value type field and on an array element field writes in place
Expected: 17
---

type Vec2
{
    x: i32
    y: i32

    init(x: i32, y: i32)
    {
        this.x = x
        this.y = y
    }
}

type Program
{
    static fn Main -> i32
    {
        var v = Vec2(1, 2)
        v.x += 5
        var arr = [Vec2(10, 0)]
        arr[0].x += 1
        return v.x + arr[0].x
    }
}
