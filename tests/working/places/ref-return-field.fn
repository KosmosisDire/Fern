---
Description: A ref return yields the element place so writes through it land in the container while a copy stays separate
Expected: 5
---

type Vec2
{
    x: i32
    y: i32

    init(x: i32, y: i32)
    {
        this.x = x
        this.y = y
    }
}

ref type Bag
{
    items: Vec2[]

    init()
    {
        items = [Vec2(1, 2), Vec2(3, 4)]
    }

    fn First() -> ref Vec2
    {
        return items[0]
    }
}

type Program
{
    static fn Main -> i32
    {
        var b = Bag()
        b.First().x = 5
        var copy = b.First()
        copy.x = 99
        return b.First().x
    }
}
