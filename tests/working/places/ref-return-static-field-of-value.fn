---
Description: A ref return may return a field of a value type static, the place is inside the static
Expected: 4
---

type Vec2
{
    x: i32

    init(x: i32)
    {
        this.x = x
    }
}

type Config
{
    static origin: Vec2 = Vec2(3)

    static fn OriginX() -> ref i32
    {
        return origin.x
    }
}

type Program
{
    static fn Main -> i32
    {
        Config.OriginX() = 4
        return Config.origin.x
    }
}
