
type Runtime
{
    @Core.Intrinsic("panic")
    static fn Panic(message: string);

    static fn CheckIndex(index: i32, length: i32)
    {
        if (index < 0 || index >= length)
        {
            Panic("index " + (string)index + " out of range (length " + (string)length + ")")
        }
    }
}

type MemoryLayout<T>
{
    -- Bytes the value occupies, trailing padding excluded
    @Core.Intrinsic("layout.size")
    static fn Size() -> i32;

    -- Bytes between consecutive elements, so Size rounded up to Alignment
    @Core.Intrinsic("layout.stride")
    static fn Stride() -> i32;

    @Core.Intrinsic("layout.align")
    static fn Alignment() -> i32;
}

type MemoryLayout
{
    static fn AlignUp(value: i32, alignment: i32) -> i32
    {
        return (value + alignment - 1) / alignment * alignment
    }
}


namespace Core

attr type BuiltinType
{
    size: i32

    init { }
    init(size: i32) { }
}
attr type AllowCustomLiterals{}
attr type SignedInt{}
attr type UnsignedInt{}
attr type NumericFloat{}

attr type Intrinsic
{
    name: string
}

@BuiltinType(1) @AllowCustomLiterals @SignedInt
type I8
{
    @Intrinsic("i8.literal_i32") literal i8(from: i32)

    @Intrinsic("i8.from_i16")
    explicit cast(from: i16) -> i8
    @Intrinsic("i8.from_i32")
    explicit cast(from: i32) -> i8
    @Intrinsic("i8.from_i64")
    explicit cast(from: i64) -> i8
    @Intrinsic("i8.from_u8")
    explicit cast(from: u8) -> i8
    @Intrinsic("i8.from_u16")
    explicit cast(from: u16) -> i8
    @Intrinsic("i8.from_u32")
    explicit cast(from: u32) -> i8
    @Intrinsic("i8.from_u64")
    explicit cast(from: u64) -> i8
    @Intrinsic("i8.from_f16")
    explicit cast(from: f16) -> i8
    @Intrinsic("i8.from_f32")
    explicit cast(from: f32) -> i8
    @Intrinsic("i8.from_f64")
    explicit cast(from: f64) -> i8

    @Intrinsic("i8.neg") op -(value: i8) -> i8
    @Intrinsic("i8.pos") op +(value: i8) -> i8
    @Intrinsic("i8.add") op +(left: i8, right: i8) -> i8
    @Intrinsic("i8.sub") op -(left: i8, right: i8) -> i8
    @Intrinsic("i8.mul") op *(left: i8, right: i8) -> i8
    @Intrinsic("i8.div") op /(left: i8, right: i8) -> i8
    @Intrinsic("i8.mod") op %(left: i8, right: i8) -> i8
    @Intrinsic("i8.eq") op ==(left: i8, right: i8) -> bool
    @Intrinsic("i8.ne") op !=(left: i8, right: i8) -> bool
    @Intrinsic("i8.gt") op >(left: i8, right: i8) -> bool
    @Intrinsic("i8.lt") op <(left: i8, right: i8) -> bool
    @Intrinsic("i8.ge") op >=(left: i8, right: i8) -> bool
    @Intrinsic("i8.le") op <=(left: i8, right: i8) -> bool
}

