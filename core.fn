    @Intrinsic("isize.literal_i64") literal isize(from: i64)

    @Intrinsic("isize.from_i8")
    implicit cast(from: i8) -> isize
    @Intrinsic("isize.from_i16")
    implicit cast(from: i16) -> isize
    @Intrinsic("isize.from_i32")
    implicit cast(from: i32) -> isize
    @Intrinsic("isize.from_u8")
    implicit cast(from: u8) -> isize
    @Intrinsic("isize.from_u16")
    implicit cast(from: u16) -> isize
    @Intrinsic("isize.from_i64")
    explicit cast(from: i64) -> isize
    @Intrinsic("isize.from_u32")
    explicit cast(from: u32) -> isize
    @Intrinsic("isize.from_u64")
    explicit cast(from: u64) -> isize
    @Intrinsic("isize.from_usize")
    explicit cast(from: usize) -> isize
    @Intrinsic("isize.from_f16")
    explicit cast(from: f16) -> isize
    @Intrinsic("isize.from_f32")
    explicit cast(from: f32) -> isize
    @Intrinsic("isize.from_f64")
    explicit cast(from: f64) -> isize

    @Intrinsic("isize.neg") op -(value: isize) -> isize
    @Intrinsic("isize.pos") op +(value: isize) -> isize
    @Intrinsic("isize.add") op +(left: isize, right: isize) -> isize
    @Intrinsic("isize.sub") op -(left: isize, right: isize) -> isize
    @Intrinsic("isize.mul") op *(left: isize, right: isize) -> isize
    @Intrinsic("isize.div") op /(left: isize, right: isize) -> isize
    @Intrinsic("isize.mod") op %(left: isize, right: isize) -> isize
    @Intrinsic("isize.eq") op ==(left: isize, right: isize) -> bool
    @Intrinsic("isize.ne") op !=(left: isize, right: isize) -> bool
    @Intrinsic("isize.gt") op >(left: isize, right: isize) -> bool
    @Intrinsic("isize.lt") op <(left: isize, right: isize) -> bool
    @Intrinsic("isize.ge") op >=(left: isize, right: isize) -> bool
    @Intrinsic("isize.le") op <=(left: isize, right: isize) -> bool
}

