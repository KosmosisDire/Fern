    @Intrinsic("bool.from_i64")
    explicit cast(from: i64) -> bool

    @Intrinsic("bool.not") op !(value: bool) -> bool
    @Intrinsic("bool.eq") op ==(left: bool, right: bool) -> bool
    @Intrinsic("bool.ne") op !=(left: bool, right: bool) -> bool
    @Intrinsic("bool.and") op &&(left: bool, right: bool) -> bool
    @Intrinsic("bool.or") op ||(left: bool, right: bool) -> bool
