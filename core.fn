    @Intrinsic("f16.from_f64")
    explicit cast(from: f64) -> f16

    @Intrinsic("f16.neg") op -(value: f16) -> f16
    @Intrinsic("f16.pos") op +(value: f16) -> f16
    @Intrinsic("f16.add") op +(left: f16, right: f16) -> f16
    @Intrinsic("f16.sub") op -(left: f16, right: f16) -> f16
    @Intrinsic("f16.mul") op *(left: f16, right: f16) -> f16
    @Intrinsic("f16.div") op /(left: f16, right: f16) -> f16
    @Intrinsic("f16.mod") op %(left: f16, right: f16) -> f16
    @Intrinsic("f16.eq") op ==(left: f16, right: f16) -> bool
    @Intrinsic("f16.ne") op !=(left: f16, right: f16) -> bool
    @Intrinsic("f16.gt") op >(left: f16, right: f16) -> bool
    @Intrinsic("f16.lt") op <(left: f16, right: f16) -> bool
    @Intrinsic("f16.ge") op >=(left: f16, right: f16) -> bool
    @Intrinsic("f16.le") op <=(left: f16, right: f16) -> bool
}

