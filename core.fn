    @Intrinsic("usize.from_u32")
    implicit cast(from: u32) -> usize
    @Intrinsic("usize.from_i8")
    explicit cast(from: i8) -> usize
    @Intrinsic("usize.from_i16")
    explicit cast(from: i16) -> usize
    @Intrinsic("usize.from_i32")
    explicit cast(from: i32) -> usize
    @Intrinsic("usize.from_i64")
    explicit cast(from: i64) -> usize
